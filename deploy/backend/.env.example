# Production-значения. Копируем в .env на сервере и заменяем все CHANGE_ME.

# Тег образов. В release-артефакте подставляется CI автоматически.
IMAGE_TAG=v0.1.0-test.5

# Gateway публикуется только на loopback; reverse proxy infra
# Nginx проксирует https://app.example.com/api и /hubs.
GATEWAY_PORT=8080

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
USER_DB_PASSWORD=CHANGE_ME_USER_SERVICE_PASSWORD
CHAT_DB_PASSWORD=CHANGE_ME_CHAT_SERVICE_PASSWORD

RABBITMQ_DEFAULT_USER=messenger
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASSWORD

# Минимум 32 случайных символа. Должен совпадать у gateway и всех сервисов.
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARACTERS
JWT_ISSUER=messenger
JWT_AUDIENCE=messenger-api
